    private function get_google_sheet_sync_settings()
    {
        $defaults = [
            'enabled' => 0,
            'webhook_url' => '',
            'spreadsheet_url' => 'https://docs.google.com/spreadsheets/d/1blky2A_FGfE2P9x_YEmEnD6kTz8OWyPxNUPdmlKG0FU/edit?usp=sharing',
            'sheet_tab_name' => 'Orders',
            'trigger_status' => 'processing',
            'row_mode' => 'order_item',
            'default_sheet_status' => 'waiting for booster',
            'duplicate_handling' => 'skip',
        ];

        $settings = get_option($this->google_sheet_sync_option_name, []);

        if (!is_array($settings)) {
            $settings = [];
        }

        return wp_parse_args($settings, $defaults);
    }

    private function sync_order_to_google_sheet($order_id)
    {
        $settings = $this->get_google_sheet_sync_settings();

        if (empty($settings['enabled'])) {
            return false;
        }

        if (empty($settings['webhook_url'])) {
            $this->log_google_sheet_sync(
                'Google Sheet sync is enabled but webhook URL is empty.',
                ['order_id' => $order_id],
                'warning'
            );
            return false;
        }

        $order = wc_get_order($order_id);

        if (!$order) {
            $this->log_google_sheet_sync(
                'Order not found while preparing Google Sheet sync.',
                ['order_id' => $order_id],
                'error'
            );
            return false;
        }

        $payload = $this->build_google_sheet_sync_payload($order, $settings);

        if (empty($payload['rows'])) {
            return false;
        }

        $response = wp_remote_post($settings['webhook_url'], [
            'timeout' => 20,
            'headers' => [
                'Content-Type' => 'application/json; charset=utf-8',
            ],
            'body' => wp_json_encode($payload),
        ]);

        if (is_wp_error($response)) {
            $this->log_google_sheet_sync(
                'Google Sheet sync request failed.',
                [
                    'order_id' => $order_id,
                    'error' => $response->get_error_message(),
                ],
                'error'
            );
            $order->add_order_note('Google Sheet sync failed: ' . $response->get_error_message());
            return false;
        }

        $response_code = wp_remote_retrieve_response_code($response);
        $response_body = wp_remote_retrieve_body($response);

        if ($response_code < 200 || $response_code >= 300) {
            $this->log_google_sheet_sync(
                'Google Sheet sync returned non-success status.',
                [
                    'order_id' => $order_id,
                    'response_code' => $response_code,
                    'response_body' => $response_body,
                ],
                'error'
            );
            $order->add_order_note('Google Sheet sync failed with HTTP ' . $response_code . '.');
            return false;
        }

        $this->mark_google_sheet_sync_exported($order, $payload['rows'], $settings['row_mode']);

        $this->log_google_sheet_sync(
            'Order synced to Google Sheet.',
            [
                'order_id' => $order_id,
                'rows_count' => count($payload['rows']),
                'response_code' => $response_code,
            ]
        );

        return true;
    }

    private function build_google_sheet_sync_payload($order, $settings)
    {
        $rows = [];
        $row_mode = $settings['row_mode'];
        $duplicate_handling = $settings['duplicate_handling'];

        if ($row_mode === 'order') {
            $already_synced = get_post_meta($order->get_id(), $this->google_sheet_sync_order_meta, true);

            if ($duplicate_handling === 'skip' && !empty($already_synced)) {
                return ['rows' => []];
            }

            $rows[] = $this->build_google_sheet_order_row($order, $settings);
        } else {
            foreach ($order->get_items() as $item_id => $item) {
                $already_synced = wc_get_order_item_meta($item_id, $this->google_sheet_sync_item_meta, true);

                if ($duplicate_handling === 'skip' && !empty($already_synced)) {
                    continue;
                }

                $rows[] = $this->build_google_sheet_item_row($order, $item_id, $item, $settings);
            }
        }

        return [
            'event' => 'woocommerce_order_status_' . $order->get_status(),
            'source' => home_url('/'),
            'spreadsheet_url' => $settings['spreadsheet_url'],
            'spreadsheet_id' => $this->extract_google_sheet_id($settings['spreadsheet_url']),
            'sheet_tab_name' => $settings['sheet_tab_name'],
            'row_mode' => $row_mode,
            'duplicate_handling' => $duplicate_handling,
            'trigger_status' => $settings['trigger_status'],
            'order' => [
                'order_id' => $order->get_id(),
                'order_number' => $order->get_order_number(),
                'status' => $order->get_status(),
                'currency' => $order->get_currency(),
                'total' => wc_format_decimal($order->get_total(), 2),
                'created_at' => $order->get_date_created() ? $order->get_date_created()->date('c') : '',
                'customer_note' => $order->get_customer_note(),
                'discord_id' => $this->get_order_discord_id($order),
            ],
            'rows' => array_values(array_filter($rows)),
        ];
    }

    private function build_google_sheet_order_row($order, $settings)
    {
        $product_names = [];
        $total_qty = 0;
        $regions = [];

        foreach ($order->get_items() as $item_id => $item) {
            $product_names[] = $item->get_name();
            $total_qty += (int) $item->get_quantity();

            $region = $this->get_order_item_region($item);
            if ($region !== '') {
                $regions[] = $region;
            }
        }

        return [
            'row_key' => 'order:' . $order->get_id(),
            'order_item_id' => null,
            'date' => $order->get_date_created() ? $order->get_date_created()->date('m/d/Y') : '',
            'created_at' => $order->get_date_created() ? $order->get_date_created()->date('c') : '',
            'order_id' => $order->get_id(),
            'order_number' => $order->get_order_number(),
            'discord_id' => $this->get_order_discord_id($order),
            'order_specification' => implode(' | ', $product_names),
            'order_status' => $settings['default_sheet_status'],
            'woocommerce_status' => $order->get_status(),
            'currency' => $order->get_currency(),
            'price' => wc_format_decimal($order->get_total(), 2),
            'qty' => $total_qty,
            'region' => implode(' | ', array_unique($regions)),
            'customer_note' => $order->get_customer_note(),
            'customer_email' => $order->get_billing_email(),
            'customer_name' => trim($order->get_billing_first_name() . ' ' . $order->get_billing_last_name()),
            'order_admin_url' => admin_url('post.php?post=' . $order->get_id() . '&action=edit'),
        ];
    }

    private function build_google_sheet_item_row($order, $item_id, $item, $settings)
    {
        $product = $item->get_product();
        $qty = (int) $item->get_quantity();
        $line_total = wc_format_decimal($item->get_total(), 2);
        $unit_price = $qty > 0 ? wc_format_decimal(((float) $item->get_total()) / $qty, 2) : $line_total;

        return [
            'row_key' => 'order_item:' . $order->get_id() . ':' . $item_id,
            'order_item_id' => $item_id,
            'date' => $order->get_date_created() ? $order->get_date_created()->date('m/d/Y') : '',
            'created_at' => $order->get_date_created() ? $order->get_date_created()->date('c') : '',
            'order_id' => $order->get_id(),
            'order_number' => $order->get_order_number(),
            'discord_id' => $this->get_order_discord_id($order),
            'order_specification' => $item->get_name(),
            'product_name' => $item->get_name(),
            'product_id' => $item->get_product_id(),
            'variation_id' => $item->get_variation_id(),
            'sku' => $product ? $product->get_sku() : '',
            'order_status' => $settings['default_sheet_status'],
            'woocommerce_status' => $order->get_status(),
            'currency' => $order->get_currency(),
            'price' => $line_total,
            'unit_price' => $unit_price,
            'qty' => $qty,
            'region' => $this->get_order_item_region($item),
            'customer_note' => $order->get_customer_note(),
            'customer_email' => $order->get_billing_email(),
            'customer_name' => trim($order->get_billing_first_name() . ' ' . $order->get_billing_last_name()),
            'order_admin_url' => admin_url('post.php?post=' . $order->get_id() . '&action=edit'),
            'item_meta' => $this->format_order_item_meta_for_sync($item),
        ];
    }

    private function format_order_item_meta_for_sync($item)
    {
        $formatted_meta = [];

        foreach ($item->get_formatted_meta_data() as $meta) {
            $formatted_meta[] = [
                'key' => isset($meta->display_key) ? wp_strip_all_tags($meta->display_key) : '',
                'value' => isset($meta->display_value) ? wp_strip_all_tags($meta->display_value) : '',
            ];
        }

        return $formatted_meta;
    }

    private function get_order_item_region($item)
    {
        $variation_id = $item->get_variation_id();

        if ($variation_id) {
            $variation_product = wc_get_product($variation_id);

            if ($variation_product) {
                $attributes = $variation_product->get_variation_attributes();
                if (!empty($attributes['attribute_region'])) {
                    return (string) $attributes['attribute_region'];
                }
            }
        }

        foreach ($item->get_meta_data() as $meta) {
            if (!isset($meta->key)) {
                continue;
            }

            if (sanitize_key($meta->key) === 'region') {
                return is_scalar($meta->value) ? (string) $meta->value : '';
            }
        }

        return '';
    }

    private function get_order_discord_id($order)
    {
        $discord_id = $order->get_meta('_billing_discord_id', true);

        if ($discord_id === '') {
            $discord_id = $order->get_meta('billing_discord_id', true);
        }

        return is_scalar($discord_id) ? (string) $discord_id : '';
    }

    private function extract_google_sheet_id($spreadsheet_url)
    {
        if (!is_string($spreadsheet_url) || $spreadsheet_url === '') {
            return '';
        }

        if (preg_match('~/spreadsheets/d/([a-zA-Z0-9-_]+)~', $spreadsheet_url, $matches)) {
            return $matches[1];
        }

        return '';
    }

    private function mark_google_sheet_sync_exported($order, $rows, $row_mode)
    {
        $synced_at = current_time('mysql', true);

        update_post_meta($order->get_id(), $this->google_sheet_sync_order_meta, $synced_at);

        if ($row_mode !== 'order_item') {
            return;
        }

        foreach ($rows as $row) {
            if (empty($row['order_item_id'])) {
                continue;
            }

            wc_update_order_item_meta((int) $row['order_item_id'], $this->google_sheet_sync_item_meta, $synced_at);
        }
    }

    private function log_google_sheet_sync($message, $context = [], $level = 'info')
    {
        $context = is_array($context) ? $context : [];
        $context['source'] = 'gladiator_google_sheet_sync';

        if (function_exists('wc_get_logger')) {
            $logger = wc_get_logger();

            if (method_exists($logger, $level)) {
                $logger->{$level}($message, $context);
                return;
            }

            $logger->info($message, $context);
            return;
        }

        error_log($message . ' ' . wp_json_encode($context));
    }

